PORT=3001

# Infrastructure — matches ExpatsPOC/docker-compose.yml
DATABASE_URL=postgres://expats:expats@localhost:5435/expats
REDIS_URL=redis://localhost:6381

# LLM — 'mock' until the AWS account can invoke Bedrock
LLM_PROVIDER=gemini
LLM_MODEL_ANSWER=
LLM_MODEL_CLASSIFY=
AWS_REGION=us-east-1

# Embeddings.
# EMBEDDING_DIMENSIONS must match the vector(N) column on document_chunks.
# Changing the provider means altering that column and re-embedding everything.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=384

# Pipeline
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=50
RETRIEVAL_TOP_K=5
RETRIEVAL_FALLBACK_MIN=3
RETRIEVAL_MIN_SIMILARITY=0.65
CACHE_TTL_HOURS=24

# Storage — MinIO locally, real S3 in production (same SDK)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=expats
S3_SECRET_KEY=expats123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_KB=expats-knowledge-base
S3_BUCKET_UPLOADS=expats-user-uploads
S3_PRESIGN_EXPIRY=900

# Auth — POC only. Production verifies a Firebase token instead.
JWT_SECRET=dev-only-change-me
JWT_EXPIRY=7d

# ---------------------------------------------------------------- deployment
# Everything below only matters once the POC is reachable from the internet.
# Locally, leaving them unset keeps the old behaviour.

# Marks this as a public instance. Turns on the startup checks in main.ts,
# which refuse to boot if the controls below are missing. Render sets RENDER=true
# on its own, so this is belt and braces.
DEPLOYED=false

# Hosted Postgres (Supabase, Neon, RDS) requires TLS. The local container does not.
DATABASE_SSL=false

# Close public sign-up. Demo accounts come from `npm run seed:demo` instead.
REGISTRATION_ENABLED=true

# Gates /api/admin, /api/documents and the feedback queue. These can delete the
# knowledge base, so an empty value is refused on a deployed instance.
# Generate one with: openssl rand -hex 24
ADMIN_API_KEY=

# Browser origins allowed to call this API, comma separated. Empty reflects any
# origin, which is fine locally and wrong in public.
# e.g. https://expats-poc.vercel.app
CORS_ORIGINS=

# Password given to the seeded demo accounts.
DEMO_PASSWORD=

# ============================================================ local infrastructure
# Read by docker-compose.yml in this folder, not by the application. These spin up
# Postgres+pgvector, Redis, MinIO and pgAdmin for local development only; a deployed
# instance uses hosted services and ignores everything below.
#
# The passwords here are deliberately trivial and are committed on purpose: the
# containers bind to localhost and hold nothing but test data. Never reuse any of
# them for anything reachable from outside this machine.
# ============================================================================
# Infrastructure credentials for docker compose.
#
# Compose reads this file automatically for ${VAR} substitution, so nothing
# here is hardcoded in docker-compose.yml.
#
# These are local development values. They are not secrets, but the file is
# gitignored anyway so the habit holds when real ones replace them.
#
# The API keeps its own copy in api/.env — the two MUST agree. Change one,
# change the other.
# ============================================================================

# --- PostgreSQL + pgvector -------------------------------------------------
POSTGRES_USER=expats
POSTGRES_PASSWORD=expats
POSTGRES_DB=expats
# 5432 is already taken on this machine by the host's own PostgreSQL.
POSTGRES_PORT=5435

# --- Redis -----------------------------------------------------------------
# 6379 is likewise taken by a host Redis.
REDIS_PORT=6381

# --- MinIO (S3-compatible object storage) ----------------------------------
MINIO_ROOT_USER=expats
MINIO_ROOT_PASSWORD=expats123
MINIO_API_PORT=9000        # the API talks to this
MINIO_CONSOLE_PORT=9001    # you open this in a browser
MINIO_BUCKET_KB=expats-knowledge-base
MINIO_BUCKET_UPLOADS=expats-user-uploads

# --- pgAdmin ---------------------------------------------------------------
# A .local domain is rejected by pgAdmin's email validation at startup and the
# container will restart-loop. Use a normal domain.
PGADMIN_EMAIL=admin@expats.com
PGADMIN_PASSWORD=expats
PGADMIN_PORT=5050
